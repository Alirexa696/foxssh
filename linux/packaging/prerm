#!/bin/sh
systemctl stop foxssh.service >/dev/null 2>&1 || true
case "$1" in
  remove|upgrade|deconfigure)
    # سرویس کاربر را برای کاربران لاگین‌شده متوقف کن، سپس رابط را ببند
    for d in /run/user/*; do
      [ -d "$d" ] || continue
      uid=${d##*/}
      [ "$uid" -ge 1000 ] 2>/dev/null || continue
      u=$(id -nu "$uid" 2>/dev/null) || continue
      runuser -u "$u" -- env XDG_RUNTIME_DIR="$d" systemctl --user stop foxssh-tray.service >/dev/null 2>&1 || true
    done
    pkill -f 'com.foxssh.desktop.Gui' >/dev/null 2>&1 || true
    ;;
esac
if [ "$1" = "remove" ]; then
  systemctl --global disable foxssh-tray.service >/dev/null 2>&1 || true
fi
exit 0
