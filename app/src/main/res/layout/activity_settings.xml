<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/settings" android:textColor="@color/text"
            android:textSize="20sp" android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/dns_section"
            android:textColor="@color/accent" android:textStyle="bold" />
        <EditText android:id="@+id/dns1" style="@style/Field" android:hint="@string/dns1"
            android:inputType="phone" />
        <EditText android:id="@+id/dns2" style="@style/Field" android:hint="@string/dns2"
            android:inputType="phone" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/dns_note"
            android:textColor="@color/muted" android:textSize="12sp" />

        <Switch android:id="@+id/ipv6"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/ipv6_switch"
            android:textColor="@color/text" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/ipv6_note"
            android:textColor="@color/muted" android:textSize="12sp" />

        <Switch android:id="@+id/bypass"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/bypass_enable"
            android:textColor="@color/text" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/bypass_desc"
            android:textColor="@color/muted" android:textSize="12sp" />
        <Button android:id="@+id/manageBypass" style="@style/Btn" android:text="@string/manage_bypass"
            android:background="@drawable/btn_dark" />

        <Button android:id="@+id/viewLog" style="@style/Btn" android:text="@string/view_log"
            android:background="@drawable/btn_dark" />
        <Button android:id="@+id/forgetKeys" style="@style/Btn" android:text="@string/forget_keys"
            android:background="@drawable/btn_dark" />
        <Button android:id="@+id/saveSettings" style="@style/Btn" android:text="@string/save" />
    </LinearLayout>
</ScrollView>
