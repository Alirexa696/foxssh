<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="rtl">
    <include layout="@layout/bar" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <EditText android:id="@+id/name" style="@style/Field" android:hint="@string/profile_name"
                android:textDirection="rtl" android:inputType="text" />
            <EditText android:id="@+id/host" style="@style/Field" android:hint="@string/server"
                android:inputType="textUri" />
            <EditText android:id="@+id/port" style="@style/Field" android:hint="@string/ssh_port"
                android:inputType="number" />
            <EditText android:id="@+id/user" style="@style/Field" android:hint="@string/username"
                android:inputType="text" />
            <EditText android:id="@+id/pass" style="@style/Field" android:hint="@string/password"
                android:inputType="textPassword" />
            <EditText android:id="@+id/udpgw" style="@style/Field" android:hint="@string/udpgw_hint"
                android:inputType="number" />
            <Button android:id="@+id/delete" style="@style/Btn" android:text="@string/delete"
                android:background="@drawable/btn_dark" android:textColor="@color/bad" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
