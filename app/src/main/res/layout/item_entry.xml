<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="8dp" android:background="@drawable/card_bg"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="14dp" android:paddingEnd="6dp" android:paddingTop="4dp"
    android:paddingBottom="4dp" android:layoutDirection="rtl">
    <TextView android:id="@+id/text"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="@color/text" android:textDirection="ltr" android:gravity="start" />
    <Button android:id="@+id/del"
        android:layout_width="wrap_content" android:layout_height="40dp"
        android:background="@null" android:text="✕" android:textColor="@color/bad" />
</LinearLayout>
