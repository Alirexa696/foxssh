<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView
                android:layout_width="56dp" android:layout_height="56dp"
                android:src="@drawable/ic_logo" android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="@string/app_name"
                android:textColor="@color/text" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:background="@drawable/card_bg"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textSize="20sp" android:textStyle="bold"
                android:textColor="@color/muted" />
            <TextView android:id="@+id/stats"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:gravity="center"
                android:textColor="@color/muted" android:textSize="13sp" />
            <TextView android:id="@+id/error"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:gravity="center"
                android:textColor="@color/bad" android:textSize="13sp" android:visibility="gone" />
        </LinearLayout>

        <EditText android:id="@+id/host" style="@style/Field" android:hint="@string/server"
            android:inputType="textUri" />
        <EditText android:id="@+id/port" style="@style/Field" android:hint="@string/ssh_port"
            android:inputType="number" />
        <EditText android:id="@+id/user" style="@style/Field" android:hint="@string/username"
            android:inputType="text" />
        <EditText android:id="@+id/pass" style="@style/Field" android:hint="@string/password"
            android:inputType="textPassword" />
        <EditText android:id="@+id/udpgw" style="@style/Field" android:hint="@string/udpgw_port"
            android:inputType="number" />
        <CheckBox android:id="@+id/remember"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/remember"
            android:textColor="@color/text" />

        <Button android:id="@+id/connect" style="@style/Btn" android:text="@string/connect" />
        <Button android:id="@+id/banner" style="@style/Btn" android:text="@string/show_banner"
            android:background="@drawable/btn_dark" android:visibility="gone" />
        <Button android:id="@+id/rules" style="@style/Btn" android:text="@string/bypass_rules"
            android:background="@drawable/btn_dark" />
    </LinearLayout>
</ScrollView>
