<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingEnd="12dp" android:paddingTop="16dp">
        <ImageView
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_logo" android:contentDescription="@null" />
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:text="@string/app_name"
            android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
        <Button android:id="@+id/settings"
            android:layout_width="wrap_content" android:layout_height="44dp"
            android:background="@drawable/btn_dark" android:text="⚙  تنظیمات"
            android:textColor="@color/text" android:paddingStart="14dp" android:paddingEnd="14dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/card_bg" android:orientation="vertical" android:padding="18dp">
                <TextView android:id="@+id/status"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:textSize="22sp" android:textStyle="bold"
                    android:textColor="@color/muted" />
                <TextView android:id="@+id/stats"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:gravity="center"
                    android:textColor="@color/muted" android:textSize="13sp" />
                <TextView android:id="@+id/error"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:gravity="center"
                    android:textColor="@color/bad" android:textSize="13sp" android:visibility="gone" />
            </LinearLayout>

            <Button android:id="@+id/banner" style="@style/Btn" android:text="@string/show_banner"
                android:background="@drawable/btn_dark" android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:text="@string/profiles"
                android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold" />

            <LinearLayout android:id="@+id/profiles"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button android:id="@+id/addProfile" style="@style/Btn" android:text="@string/add_profile"
                android:background="@drawable/btn_dark" />
        </LinearLayout>
    </ScrollView>

    <Button android:id="@+id/connect" style="@style/Btn" android:text="@string/connect"
        android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp" android:layout_width="match_parent" />
</LinearLayout>
